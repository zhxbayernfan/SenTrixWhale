[Unit]
Description=SenTrixWhale Bridge
After=network.target

[Service]
Type=simple
User=sscy
WorkingDirectory=/home/sscy/lingbot-map/005SenTrixWhale
ExecStart=/usr/bin/node bridge/src/bridge.js
Restart=always
RestartSec=10
StandardOutput=append:/home/sscy/lingbot-map/005SenTrixWhale/state/bridge.log
StandardError=append:/home/sscy/lingbot-map/005SenTrixWhale/state/bridge.log

# 环境变量
Environment="WHILE_HOME=/home/sscy/lingbot-map/005SenTrixWhale"

# 资源限制
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
