# SenTrixWhale 部署配置文件
# 复制为 .env.deploy 并填入实际路径
# 每台部署机器各写一份, 脚本自动读取

# === 项目根目录 ===
SENTRIXWHALE_ROOT="/home/sscy/lingbot-map/005SenTrixWhale"

# === 模型路径 ===
MODEL_DIR="/home/sscy/models"
LLAMA_MODEL="qwen35-lora-Q4_K_M.gguf"
MM PROJ_MODEL="qwen35-lora-mmproj-f16.gguf"

# === llama-server ===
LLAMA_SERVER_BIN="llama-server"
LLAMA_PORT=8100
LLAMA_CTX_SIZE=32768
LLAMA_PARALLEL=4

# === NapCat ===
NAPCAT_PORT_WS=3001
NAPCAT_PORT_HTTP=3000

# === SHW ===
SHW_API_PORT=9598
SHW_API_URL="http://127.0.0.1:9598"

# === Demo ===
DEMO_PORT=7738

# === Metrics ===
METRICS_PORT=9090

# === 日志 ===
LOG_DIR="${SENTRIXWHALE_ROOT}/logs"
